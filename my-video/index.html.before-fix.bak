<!doctype html><html lang="en"><head><meta charset="UTF-8"><meta name="viewport" content="width=1080,height=1920"><script src="https://cdn.jsdelivr.net/npm/gsap@3.14.2/dist/gsap.min.js"><\/script><style>:root{--caption:#fff}*{box-sizing:border-box}html,body{margin:0;width:1080px;height:1920px;overflow:hidden;background:#080808;font-family:Arial,sans-serif}#root{position:relative;width:100%;height:100%;overflow:hidden}.shot{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;background:#111}.footage{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}.caption{position:absolute;left:7%;right:7%;bottom:16%;text-align:center;color:var(--caption);font-size:64px;line-height:1.04;font-weight:900;text-transform:uppercase;letter-spacing:-.035em;text-shadow:0 3px 14px #000,2px 2px 0 #000}</style></head><body><div id="root" data-hf-id="root" data-composition-id="main" data-start="0" data-duration="60" data-width="1080" data-height="1920"><video id="shot-0" class="clip shot footage" data-hf-id="shot-0" data-start="0.000" data-duration="2.500" data-media-start="0.000" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-0" class="clip caption" data-hf-id="caption-0" data-start="0.000" data-duration="2.500" data-track-index="1">So, before Daeko matulog,</div><video id="shot-1" class="clip shot footage" data-hf-id="shot-1" data-start="2.500" data-duration="2.500" data-media-start="2.500" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-1" class="clip caption" data-hf-id="caption-1" data-start="2.500" data-duration="2.500" data-track-index="1">and before mag-watch ako ang face,</div><video id="shot-2" class="clip shot footage" data-hf-id="shot-2" data-start="5.000" data-duration="2.500" data-media-start="5.000" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-2" class="clip caption" data-hf-id="caption-2" data-start="5.000" data-duration="2.500" data-track-index="1">naray ko yung isa pang awal na chismis ninyo.</div><video id="shot-3" class="clip shot footage" data-hf-id="shot-3" data-start="7.500" data-duration="2.500" data-media-start="7.500" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-3" class="clip caption" data-hf-id="caption-3" data-start="7.500" data-duration="2.500" data-track-index="1">Like, out of the blue lang dyan kayo ito siya nga.</div><video id="shot-4" class="clip shot footage" data-hf-id="shot-4" data-start="10.000" data-duration="2.500" data-media-start="10.000" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-4" class="clip caption" data-hf-id="caption-4" data-start="10.000" data-duration="2.500" data-track-index="1">Well, nag-discuss ko sa akong klase, ano ba?</div><video id="shot-5" class="clip shot footage" data-hf-id="shot-5" data-start="12.500" data-duration="2.500" data-media-start="12.500" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-5" class="clip caption" data-hf-id="caption-5" data-start="12.500" data-duration="2.500" data-track-index="1">Kay, di, madyo,</div><video id="shot-6" class="clip shot footage" data-hf-id="shot-6" data-start="15.000" data-duration="2.500" data-media-start="15.000" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-6" class="clip caption" data-hf-id="caption-6" data-start="15.000" data-duration="2.500" data-track-index="1">magsigig balik-balik sa akong unahuna,</div><video id="shot-7" class="clip shot footage" data-hf-id="shot-7" data-start="17.500" data-duration="2.500" data-media-start="17.500" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-7" class="clip caption" data-hf-id="caption-7" data-start="17.500" data-duration="2.500" data-track-index="1">and gusto nung sad na ako i-share sa inyo, ah.</div><video id="shot-8" class="clip shot footage" data-hf-id="shot-8" data-start="20.000" data-duration="2.500" data-media-start="20.000" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-8" class="clip caption" data-hf-id="caption-8" data-start="20.000" data-duration="2.500" data-track-index="1">Kay, mo dae ang ilang thinking,</div><video id="shot-9" class="clip shot footage" data-hf-id="shot-9" data-start="22.500" data-duration="2.500" data-media-start="22.500" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-9" class="clip caption" data-hf-id="caption-9" data-start="22.500" data-duration="2.500" data-track-index="1">ah, one of my students,</div><video id="shot-10" class="clip shot footage" data-hf-id="shot-10" data-start="25.000" data-duration="2.500" data-media-start="25.000" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-10" class="clip caption" data-hf-id="caption-10" data-start="25.000" data-duration="2.500" data-track-index="1">Like, kanang nag-discuss ko,</div><video id="shot-11" class="clip shot footage" data-hf-id="shot-11" data-start="27.500" data-duration="2.500" data-media-start="27.500" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-11" class="clip caption" data-hf-id="caption-11" data-start="27.500" data-duration="2.500" data-track-index="1">tag-aasa Daeko,</div><video id="shot-12" class="clip shot footage" data-hf-id="shot-12" data-start="30.000" data-duration="2.500" data-media-start="30.000" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-12" class="clip caption" data-hf-id="caption-12" data-start="30.000" data-duration="2.500" data-track-index="1">teacher, teacher, where are you from?</div><video id="shot-13" class="clip shot footage" data-hf-id="shot-13" data-start="32.500" data-duration="2.500" data-media-start="32.500" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-13" class="clip caption" data-hf-id="caption-13" data-start="32.500" data-duration="2.500" data-track-index="1">yan, ano siya, I&#39;m from the Philippines</div><video id="shot-14" class="clip shot footage" data-hf-id="shot-14" data-start="35.000" data-duration="2.500" data-media-start="35.000" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-14" class="clip caption" data-hf-id="caption-14" data-start="35.000" data-duration="2.500" data-track-index="1">kung sabi buhat niya</div><video id="shot-15" class="clip shot footage" data-hf-id="shot-15" data-start="37.500" data-duration="2.500" data-media-start="37.500" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-15" class="clip caption" data-hf-id="caption-15" data-start="37.500" data-duration="2.500" data-track-index="1">nagigistulia</div><video id="shot-16" class="clip shot footage" data-hf-id="shot-16" data-start="40.000" data-duration="2.500" data-media-start="40.000" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-16" class="clip caption" data-hf-id="caption-16" data-start="40.000" data-duration="2.500" data-track-index="1">ano siya, nagigistulia</div><video id="shot-17" class="clip shot footage" data-hf-id="shot-17" data-start="42.500" data-duration="2.500" data-media-start="42.500" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-17" class="clip caption" data-hf-id="caption-17" data-start="42.500" data-duration="2.500" data-track-index="1">what are you talking about?</div><video id="shot-18" class="clip shot footage" data-hf-id="shot-18" data-start="45.000" data-duration="2.500" data-media-start="45.000" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-18" class="clip caption" data-hf-id="caption-18" data-start="45.000" data-duration="2.500" data-track-index="1">ano siya, teacher</div><video id="shot-19" class="clip shot footage" data-hf-id="shot-19" data-start="47.500" data-duration="2.500" data-media-start="47.500" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-19" class="clip caption" data-hf-id="caption-19" data-start="47.500" data-duration="2.500" data-track-index="1">ano siya, yes</div><video id="shot-20" class="clip shot footage" data-hf-id="shot-20" data-start="50.000" data-duration="2.500" data-media-start="50.000" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-20" class="clip caption" data-hf-id="caption-20" data-start="50.000" data-duration="2.500" data-track-index="1">teacher, you are poor</div><video id="shot-21" class="clip shot footage" data-hf-id="shot-21" data-start="52.500" data-duration="2.500" data-media-start="52.500" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-21" class="clip caption" data-hf-id="caption-21" data-start="52.500" data-duration="2.500" data-track-index="1">dahil sinampal ako ng kahirapan</div><video id="shot-22" class="clip shot footage" data-hf-id="shot-22" data-start="55.000" data-duration="2.500" data-media-start="55.000" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-22" class="clip caption" data-hf-id="caption-22" data-start="55.000" data-duration="2.500" data-track-index="1">dahil, ano siya, what?</div><video id="shot-23" class="clip shot footage" data-hf-id="shot-23" data-start="57.500" data-duration="2.500" data-media-start="57.500" data-track-index="0" src="uploads/b673c85b-4001-4a39-a8f8-40b1002dc67a-source.mp4" muted playsinline preload="auto"></video><div id="caption-23" class="clip caption" data-hf-id="caption-23" data-start="57.500" data-duration="2.500" data-track-index="1">ano siya, teacher, you are poor</div></div><script>window.__timelines=window.__timelines||{};const tl=gsap.timeline({paused:true});tl.fromTo("#shot-0",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},0);tl.fromTo("#shot-1",{scale:1},{scale:1.12,duration:0.45,ease:"power2.out"},2.5);tl.fromTo("#shot-2",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},5);tl.fromTo("#shot-3",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},7.5);tl.fromTo("#shot-4",{scale:1},{scale:1.12,duration:0.45,ease:"power2.out"},10);tl.fromTo("#shot-5",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},12.5);tl.fromTo("#shot-6",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},15);tl.fromTo("#shot-7",{scale:1},{scale:1.12,duration:0.45,ease:"power2.out"},17.5);tl.fromTo("#shot-8",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},20);tl.fromTo("#shot-9",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},22.5);tl.fromTo("#shot-10",{scale:1},{scale:1.12,duration:0.45,ease:"power2.out"},25);tl.fromTo("#shot-11",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},27.5);tl.fromTo("#shot-12",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},30);tl.fromTo("#shot-13",{scale:1},{scale:1.12,duration:0.45,ease:"power2.out"},32.5);tl.fromTo("#shot-14",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},35);tl.fromTo("#shot-15",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},37.5);tl.fromTo("#shot-16",{scale:1},{scale:1.12,duration:0.45,ease:"power2.out"},40);tl.fromTo("#shot-17",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},42.5);tl.fromTo("#shot-18",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},45);tl.fromTo("#shot-19",{scale:1},{scale:1.12,duration:0.45,ease:"power2.out"},47.5);tl.fromTo("#shot-20",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},50);tl.fromTo("#shot-21",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},52.5);tl.fromTo("#shot-22",{scale:1},{scale:1.12,duration:0.45,ease:"power2.out"},55);tl.fromTo("#shot-23",{scale:1},{scale:1.04,duration:0.45,ease:"power2.out"},57.5);window.__timelines["main"]=tl;tl.seek(0);<\/script></body></html>